# ── AI-03 Fall Detection ── Environment Variables ──────────────────────────────
# Copy this file to .env and fill in real values.  Never commit .env to VCS.

# Path to the raw UMAFall CSV dataset directory
DATASET_DIR=d:/Farhan/Assignment/Dataset

# Path where extracted feature CSVs are saved
FEATURES_DIR=d:/Farhan/Assignment/AI-03-Fall-Detection/data

# Path where trained models are saved
MODELS_DIR=d:/Farhan/Assignment/AI-03-Fall-Detection/models

# Path where evaluation reports are saved
REPORTS_DIR=d:/Farhan/Assignment/AI-03-Fall-Detection/reports

# Random seed for reproducibility
RANDOM_SEED=42

# Fall probability threshold (0-1) for inference
FALL_THRESHOLD=0.5

# Alert countdown duration in seconds
ALERT_COUNTDOWN_SECONDS=30

# Alert cooldown period in seconds (suppress duplicate alerts)
ALERT_COOLDOWN_SECONDS=60

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
